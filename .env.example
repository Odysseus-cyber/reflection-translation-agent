# 默认本地后端：先安装并启动 Ollama，再运行 ollama pull gemma3:1b。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_NUM_CTX=16384

# 可选：兼容 Chat Completions 的 API。地址包含服务要求的 /v1 等前缀，
# 不要填写完整的 /chat/completions 端点；选择 compatible 后端时使用。
# API_BASE_URL=https://your-provider.example/v1
API_BASE_URL=
API_MODEL=
API_KEY=

# none：通过提示词要求审校 JSON，兼容范围最广。
# json_object / json_schema：仅在供应商明确支持时启用；只影响审校阶段。
API_RESPONSE_FORMAT=none

# 每次模型调用的超时与输出 token 上限。
LLM_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=4096
